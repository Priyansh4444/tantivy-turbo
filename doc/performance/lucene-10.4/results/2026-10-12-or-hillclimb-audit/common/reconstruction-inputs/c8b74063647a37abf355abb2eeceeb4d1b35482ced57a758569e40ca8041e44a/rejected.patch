+    #[test]
+    fn callback_growth_repartitions_only_after_old_essential_advances() {
+        let norms = vec![1; 500];
+        let dense: Vec<_> = (0..300).map(|doc| (doc, 1)).collect();
+        let rare = [(0, 1), (10, 1000), (300, 1)];
+        let scorers = vec![
+            fixture(&dense, &norms, 0.1),
+            fixture(&dense, &norms, 0.2),
+            fixture(&rare, &norms, 1.0),
+        ];
+        let upper = crate::query::score_combiner::ScoreSumUpperBound::new(3);
+        let weak_certificate = upper.score(
+            f64::from(scorers[0].clone().block_max_score())
+                + f64::from(scorers[1].clone().block_max_score()),
+        );
+        let whole_certificate = upper.score(
+            f64::from(scorers[0].clone().block_max_score())
+                + f64::from(scorers[1].clone().block_max_score())
+                + f64::from(scorers[2].clone().block_max_score()),
+        );
+        // Independently enumerate every hit and replay the same callback. The
+        // callback can reject one deleted doc or hold a fixed competitive floor.
+        let run = |optimized: bool,
+                   scorers: Vec<TermScorer>,
+                   rejected: Option<DocId>,
+                   fixed_floor: Option<Score>| {
+            if optimized {
+                BATCH_LENGTHS.with(|lengths| *lengths.borrow_mut() = Some(Vec::new()));
+            }
+            let mut accepted = Vec::new();
+            let mut threshold = 0.0f32;
+            let callback = &mut |doc, score: Score| {
+                if optimized && doc < 128 {
+                    // The initial scalar region stays scalar after its 0->2
+                    // transition, even though only one essential remains.
+                    assert!(BATCH_LENGTHS.with(|lengths| lengths
+                        .borrow()
+                        .as_ref()
+                        .unwrap()
+                        .is_empty()));
+                }
+                accepted.push((doc, score.to_bits()));
+                if rejected != Some(doc) {
+                    threshold = threshold.max(fixed_floor.unwrap_or(score));
+                }
+                threshold
+            };
+            if optimized {
+                or_maxscore(scorers, 500, 0.0, callback);
+                BATCH_LENGTHS.with(|lengths| lengths.borrow_mut().take());
+            } else {
+                let mut union = BufferedUnionScorer::build(scorers, SumCombiner::default, 500);
+                for_each_pruning_scorer(&mut union, 0.0, callback);
+            }
+            assert!(accepted.windows(2).all(|pair| pair[0].0 < pair[1].0));
+            accepted
+        };
+        for reverse in [false, true] {
+            let mut ordered = scorers.clone();
+            if reverse {
+                ordered.reverse();
+            }
+            for (rejected, fixed_floor) in [
+                (None, None),
+                (Some(0), None),
+                (None, Some(weak_certificate)),
+            ] {
+                let expected = run(false, ordered.clone(), rejected, fixed_floor);
+                REPARTITIONS.with(|events| *events.borrow_mut() = Some(Vec::new()));
+                let actual = run(true, ordered.clone(), rejected, fixed_floor);
+                let events = REPARTITIONS.with(|events| events.borrow_mut().take().unwrap());
+                assert_eq!(actual, expected);
+                let first = &events[0];
+                assert_eq!(
+                    (first.lo, first.hi, first.old_first, first.new_first),
+                    (0, 128, 0, 2)
+                );
+                assert_eq!(first.doc, if rejected.is_some() { 1 } else { 0 });
+                // Demoted matching dense clauses still advance under the OLD
+                // suffix. Updating first_essential too early would leave this
+                // minimum equal to the just-processed document.
+                assert_eq!(first.old_suffix_min, first.doc + 1);
+                if rejected.is_some() || fixed_floor.is_some() {
+                    assert_eq!(first.threshold_bits, weak_certificate.to_bits());
+                }
+                if fixed_floor.is_some() {
+                    assert_eq!(events.len(), 1);
+                    assert_eq!(
+                        actual.iter().map(|&(doc, _)| doc).collect::<Vec<_>>(),
+                        [0, 10, 300]
+                    );
+                } else {
+                    assert_eq!(events.len(), 2);
+                    let last = &events[1];
+                    assert_eq!(
+                        (last.lo, last.hi, last.doc, last.old_first, last.new_first),
+                        (0, 128, 10, 2, 3)
+                    );
+                    assert_eq!(last.threshold_bits, whole_certificate.to_bits());
+                    assert_eq!(last.old_suffix_min, 300);
+                    assert_eq!(actual.last().unwrap().0, 10);
+                }
+                assert!(events.iter().all(|event| event.old_suffix_min > event.doc));
+            }
+        }
+        // Signed admission remains the untouched canonical fallback and cannot
+        // produce a region transition, despite increasing callback thresholds.
+        let signed = vec![
+            fixture(&dense, &norms, -0.1),
+            scorers[1].clone(),
+            scorers[2].clone(),
+        ];
+        let expected = run(false, signed.clone(), None, None);
+        REPARTITIONS.with(|events| *events.borrow_mut() = Some(Vec::new()));
+        assert_eq!(run(true, signed, None, None), expected);
+        assert!(REPARTITIONS.with(|events| events.borrow_mut().take().unwrap().is_empty()));
+    }
