+// Diagnostic-only binary: fixed-size counters never participate in pruning or
+// cursor movement. Presence of OR_REGION_DIAGNOSTIC enables one stderr summary.
+struct RegionDiagnostic {
+    num_terms: usize,
+    max_doc: DocId,
+    fallback: bool,
+    regions: u64,
+    physical_widths: [u64; 33],
+    essential_counts: [u64; 33],
+    cap_source_masks: [u64; 8],
+    skipped_regions: u64,
+    globally_finished: u64,
+    selected_finite_blocks: u64,
+    selected_sentinel_tails: u64,
+    batch_lengths: [u64; 129],
+    scalar_candidates: u64,
+    matching_essentials: [u64; 33],
+    optional_bound_checks: u64,
+    optional_probes: u64,
+    optional_seeks: u64,
+    scalar_boundaries: u64,
+    unique_earliest: u64,
+    gap_ge_128: u64,
+    gap_ge_2048: u64,
+}
+
+impl RegionDiagnostic {
+    fn enabled(num_terms: usize, max_doc: DocId) -> Option<Self> {
+        std::env::var_os("OR_REGION_DIAGNOSTIC").map(|_| Self {
+            num_terms,
+            max_doc,
+            fallback: false,
+            regions: 0,
+            physical_widths: [0; 33],
+            essential_counts: [0; 33],
+            cap_source_masks: [0; 8],
+            skipped_regions: 0,
+            globally_finished: 0,
+            selected_finite_blocks: 0,
+            selected_sentinel_tails: 0,
+            batch_lengths: [0; 129],
+            scalar_candidates: 0,
+            matching_essentials: [0; 33],
+            optional_bound_checks: 0,
+            optional_probes: 0,
+            optional_seeks: 0,
+            scalar_boundaries: 0,
+            unique_earliest: 0,
+            gap_ge_128: 0,
+            gap_ge_2048: 0,
+        })
+    }
+
+    fn region(
+        &mut self,
+        lo: DocId,
+        hi: DocId,
+        first_essential: usize,
+        selected_caps: &[Option<DocId>; 32],
+    ) {
+        self.regions += 1;
+        let width = hi - lo;
+        // Bin 0 is width 0; bin i covers [2^(i-1), 2^i-1].
+        self.physical_widths[(u32::BITS - width.leading_zeros()) as usize] += 1;
+        self.essential_counts[self.num_terms - first_essential] += 1;
+        let mut mask = if hi == self.max_doc { 4 } else { 0 };
+        for (rank, &cap) in selected_caps[..self.num_terms].iter().enumerate() {
+            if cap == Some(hi) {
+                mask |= if rank < first_essential { 1 } else { 2 };
+            }
+        }
+        self.cap_source_masks[mask] += 1;
+    }
+
+    fn scalar_boundary(&mut self, essentials: &[ClauseState], doc: DocId, hi: DocId) {
+        // Called only at a drained scalar boundary. These reads do not seek,
+        // score, repartition, or reorder any clause.
+        if doc >= hi {
+            return;
+        }
+        self.scalar_boundaries += 1;
+        let matches = essentials.iter().filter(|clause| clause.doc == doc).count();
+        if matches != 1 {
+            return;
+        }
+        self.unique_earliest += 1;
+        let second_doc = essentials
+            .iter()
+            .filter(|clause| clause.doc != doc)
+            .map(|clause| clause.doc)
+            .min()
+            .unwrap_or(TERMINATED);
+        let gap = hi.min(second_doc) - doc;
+        self.gap_ge_128 += u64::from(gap >= 128);
+        self.gap_ge_2048 += u64::from(gap >= 2048);
+    }
+}
+
+impl Drop for RegionDiagnostic {
+    fn drop(&mut self) {
+        // Arrays contain only integers, so Debug array syntax is valid JSON.
+        // One record per invocation, including fallback and early termination.
+        eprintln!(
+            concat!(
+                "OR_REGION_DIAGNOSTIC {{\"version\":1,\"num_terms\":{},\"max_doc\":{},",
+                "\"fallback\":{},\"regions\":{},\"physical_widths\":{:?},",
+                "\"essential_counts\":{:?},\"cap_source_masks\":{:?},",
+                "\"skipped_regions\":{},\"globally_finished\":{},",
+                "\"selected_finite_blocks\":{},\"selected_sentinel_tails\":{},",
+                "\"batch_lengths\":{:?},\"scalar_candidates\":{},",
+                "\"matching_essentials\":{:?},\"optional_bound_checks\":{},",
+                "\"optional_probes\":{},\"optional_seeks\":{},",
+                "\"scalar_boundaries\":{},\"unique_earliest\":{},",
+                "\"gap_ge_128\":{},\"gap_ge_2048\":{}}}"
+            ),
+            self.num_terms,
+            self.max_doc,
+            self.fallback,
+            self.regions,
+            self.physical_widths,
+            self.essential_counts,
+            self.cap_source_masks,
+            self.skipped_regions,
+            self.globally_finished,
+            self.selected_finite_blocks,
+            self.selected_sentinel_tails,
+            self.batch_lengths,
+            self.scalar_candidates,
+            self.matching_essentials,
+            self.optional_bound_checks,
+            self.optional_probes,
+            self.optional_seeks,
+            self.scalar_boundaries,
+            self.unique_earliest,
+            self.gap_ge_128,
+            self.gap_ge_2048,
+        );
+    }
+}
