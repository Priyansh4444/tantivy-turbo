+    #[test]
+    fn partition_expansion_admits_zero_restoration_without_promoting_a_driver() {
+        let norms = vec![1; 3000];
+        let dense: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let future: Vec<_> = (300..900)
+            .map(|doc| (doc, if doc == 428 { 1000 } else { 1 }))
+            .collect();
+        let driver: Vec<_> = (0..600).map(|i| (4 * i, 1)).collect();
+        let scorers = vec![
+            fixture(&dense, &norms, 0.01),
+            fixture(&future, &norms, 0.001),
+            fixture(&driver, &norms, 0.1),
+        ];
+        let generic = crate::query::score_combiner::ScoreSumUpperBound::new(3);
+        let weak_globals = f64::from(scorers[0].max_score()) + f64::from(scorers[1].max_score());
+        assert!(generic.score(weak_globals) <= 0.025);
+        assert!(generic.score(weak_globals + f64::from(scorers[2].max_score())) > 0.025);
+        assert_eq!(
+            scorers
+                .iter()
+                .map(TermScorer::size_hint)
+                .collect::<Vec<_>>(),
+            [1024, 600, 600]
+        );
+        for reverse in [false, true] {
+            let mut ordered = scorers.clone();
+            if reverse {
+                ordered.reverse();
+            }
+            let mut ranks: Vec<_> = (0..ordered.len()).collect();
+            ranks.sort_unstable_by(|&left, &right| {
+                let priority = |ordinal: usize| {
+                    f64::from(ordered[ordinal].max_score())
+                        / f64::from(ordered[ordinal].size_hint())
+                };
+                priority(left)
+                    .total_cmp(&priority(right))
+                    .then_with(|| left.cmp(&right))
+            });
+            let driver_ordinal = if reverse { 0 } else { 2 };
+            assert_eq!(
+                ranks,
+                if reverse {
+                    vec![1, 2, 0]
+                } else {
+                    vec![1, 0, 2]
+                }
+            );
+            for limit in [0, 1, 10] {
+                GLOBAL_CHOICES.with(|choices| *choices.borrow_mut() = Some(Vec::new()));
+                let (accepted, evidence) = check_widening(ordered.clone(), 3000, 0.025, limit);
+                let choices = GLOBAL_CHOICES.with(|choices| choices.borrow_mut().take().unwrap());
+                assert_eq!(choices[0], (0, 2, 0, 600));
+                let proposal = evidence
+                    .proposals
+                    .iter()
+                    .find(|proposal| proposal.lo == 0)
+                    .unwrap();
+                assert!(proposal.admitted);
+                assert_eq!(proposal.ordinals, ranks);
+                assert_eq!(
+                    (proposal.tight_hi, proposal.proposed_hi, proposal.hi),
+                    (128, 509, 509)
+                );
+                assert_eq!(proposal.first_essential, 2);
+                let future_rank = proposal
+                    .ordinals
+                    .iter()
+                    .position(|&ordinal| ordinal == 1)
+                    .unwrap();
+                assert_eq!(proposal.docs[future_rank], 300);
+                assert!(
+                    proposal.docs[future_rank] >= proposal.tight_hi
+                        && proposal.docs[future_rank] < proposal.hi
+                );
+                assert!(proposal.bounds[future_rank] > 0.0);
+                assert_eq!(
+                    proposal.bounds[future_rank].to_bits(),
+                    proposal.proposed_bounds[future_rank].to_bits()
+                );
+                assert!(evidence.progress.iter().any(|event| matches!(event,
+                    CursorProgress::Batch { ordinal, floor: 0, up_to: 509, docs, doc: 512, .. }
+                    if *ordinal == driver_ordinal && docs.len() == 128
+                )));
+                assert!(accepted.iter().any(|&(doc, _)| doc == 428));
+            }
+        }
+    }
