+    #[test]
+    fn partition_expansion_n3_n32_admission_and_overflow_are_both_realized() {
+        let norms = vec![1; 3000];
+        let dense: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let future: Vec<_> = (300..900)
+            .map(|doc| (doc, if doc == 428 { 1000 } else { 1 }))
+            .collect();
+        let driver: Vec<_> = (0..600).map(|i| (4 * i, 1)).collect();
+        for count in [3, 32] {
+            for reject in [false, true] {
+                let mut scorers: Vec<_> = (0..count - 2)
+                    .map(|ordinal| fixture(&dense, &norms, 0.00001 * (ordinal + 1) as Score))
+                    .collect();
+                let future_ordinal = scorers.len();
+                scorers.push(fixture(&future, &norms, if reject { 0.02 } else { 0.001 }));
+                scorers.push(fixture(&driver, &norms, 0.1));
+                for reverse in [false, true] {
+                    let mut ordered = scorers.clone();
+                    if reverse {
+                        ordered.reverse();
+                    }
+                    let future_ordinal = if reverse {
+                        count - future_ordinal - 1
+                    } else {
+                        future_ordinal
+                    };
+                    for limit in [0, 1, 10] {
+                        let (accepted, evidence) =
+                            check_widening(ordered.clone(), 3000, 0.025, limit);
+                        let proposal = evidence
+                            .proposals
+                            .iter()
+                            .find(|proposal| proposal.lo == 0)
+                            .unwrap();
+                        assert_eq!(
+                            proposal.admitted, !reject,
+                            "count={count} reverse={reverse} limit={limit}"
+                        );
+                        assert_eq!(proposal.first_essential, count - 1);
+                        assert_eq!(proposal.tight_hi, 128);
+                        assert_eq!(proposal.proposed_hi, 509);
+                        assert_eq!(proposal.hi, if reject { 128 } else { 509 });
+                        let rank = proposal
+                            .ordinals
+                            .iter()
+                            .position(|&ordinal| ordinal == future_ordinal)
+                            .unwrap();
+                        assert!(rank < proposal.first_essential);
+                        assert_eq!(proposal.docs[rank], 300);
+                        assert!(proposal.proposed_bounds[rank] > 0.0);
+                        if reject {
+                            assert_eq!(proposal.bounds[rank].to_bits(), 0.0f32.to_bits());
+                            assert_eq!(
+                                proposal.proposed_bounds.len(),
+                                rank + 1,
+                                "stop at first overflow"
+                            );
+                        } else {
+                            assert!(proposal.bounds[rank] > 0.0);
+                        }
+                        assert!(accepted.iter().any(|&(doc, _)| doc == 428));
+                    }
+                }
+            }
+        }
+    }
