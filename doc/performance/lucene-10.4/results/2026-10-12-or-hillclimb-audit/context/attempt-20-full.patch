+    // These helpers create real compressed full blocks/tails. Expected callback
+    // scores always come from BufferedUnionScorer, not from the gap certificate.
+    fn required_gap_fixture(
+        num_terms: usize,
+        driver_len: DocId,
+        optional_docs: &[DocId],
+        native: bool,
+    ) -> (Vec<TermScorer>, Score) {
+        let norms = vec![1; 2048];
+        let driver: Vec<_> = (0..driver_len).map(|doc| (doc, 1000)).collect();
+        let optional: Vec<_> = optional_docs.iter().map(|&doc| (doc, 1000)).collect();
+        let weak: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let make = |postings: &[(DocId, u32)], boost| {
+            let weight = if native {
+                Bm25Weight::for_native_block_bounds(1.0).boost_by(boost)
+            } else {
+                Bm25Weight::new_without_explain(1.0, 1.0).boost_by(boost)
+            };
+            assert!(weight.has_safe_score_bounds());
+            TermScorer::create_for_test(postings, &norms, weight)
+        };
+        let mut scorers = vec![make(&driver, 128.0), make(&optional, 1.0)];
+        for _ in 2..num_terms {
+            scorers.push(make(&weak, 0.00001));
+        }
+        let mut ranked: Vec<_> = scorers.iter().cloned().enumerate().collect();
+        ranked.sort_unstable_by(|(left_ordinal, left), (right_ordinal, right)| {
+            let priority = |scorer: &TermScorer| {
+                f64::from(scorer.max_score()) / f64::from(scorer.size_hint().max(1))
+            };
+            priority(left)
+                .total_cmp(&priority(right))
+                .then_with(|| left_ordinal.cmp(right_ordinal))
+        });
+        assert_eq!(ranked[num_terms - 1].0, 0);
+        assert_eq!(ranked[num_terms - 2].0, 1);
+        // Derive a strictness boundary from independently selected real block
+        // maxima. A partial driver has the ordinary global tail bound instead.
+        let mut excluded = 0.0f64;
+        for (rank, (_, scorer)) in ranked.iter_mut().enumerate() {
+            if rank != num_terms - 2 {
+                scorer.seek_block(0);
+                excluded += f64::from(scorer.block_max_score());
+            }
+        }
+        let threshold =
+            crate::query::score_combiner::ScoreSumUpperBound::new(num_terms).score(excluded);
+        (scorers, threshold)
+    }
+
+    fn check_required_gap_rule(
+        scorers: Vec<TermScorer>,
+        initial: Score,
+        rule: impl Fn(DocId, Score, Score) -> Score,
+    ) -> (Vec<(DocId, u32)>, Vec<RequiredGapObservation>) {
+        let run = |optimized: bool| {
+            let mut current = initial;
+            let mut accepted = Vec::new();
+            let mut callback = |doc, score: Score| {
+                accepted.push((doc, score.to_bits()));
+                let next = rule(doc, score, current);
+                assert!(next >= current);
+                current = next;
+                current
+            };
+            if optimized {
+                or_maxscore(scorers.clone(), 2048, initial, &mut callback);
+            } else {
+                let mut union =
+                    BufferedUnionScorer::build(scorers.clone(), SumCombiner::default, 2048);
+                for_each_pruning_scorer(&mut union, initial, &mut callback);
+            }
+            assert!(accepted.windows(2).all(|pair| pair[0].0 < pair[1].0));
+            accepted
+        };
+        let expected = run(false);
+        REQUIRED_GAPS.with(|observations| *observations.borrow_mut() = Some(Vec::new()));
+        let actual = run(true);
+        let observations =
+            REQUIRED_GAPS.with(|observations| observations.borrow_mut().take().unwrap());
+        assert_eq!(actual, expected);
+        for observation in &observations {
+            assert_eq!(observation.num_terms, scorers.len());
+            assert_eq!(observation.rank + 2, observation.num_terms);
+            assert_eq!(observation.owned_before, observation.owned_after);
+            assert_eq!(observation.owned_before.len(), observation.batch_len);
+            assert_eq!(
+                observation.pending_before,
+                observation.owned_before[observation.batch_index..]
+            );
+            assert_eq!(observation.lower_before, observation.lower_after);
+            assert!(observation
+                .lower_before
+                .iter()
+                .all(|&(mirror, real)| mirror == real));
+            assert_eq!(observation.driver_before, observation.driver_after);
+            assert_eq!(observation.driver_before.0, observation.driver_before.1);
+            assert_eq!(observation.driver_before.0, observation.driver_doc);
+            assert_eq!(
+                observation.pending_before.len(),
+                observation.batch_len - observation.batch_index
+            );
+            assert_eq!(observation.pending_before[0].0, observation.trigger);
+            assert!(observation
+                .pending_before
+                .windows(2)
+                .all(|pair| pair[0].0 < pair[1].0));
+            assert!(observation
+                .pending_before
+                .iter()
+                .all(|&(doc, _)| doc < observation.hi));
+            let naive_count = observation
+                .pending_before
+                .iter()
+                .take_while(|&&(doc, _)| doc < observation.target)
+                .count();
+            let actually_skipped = observation.next_index - observation.batch_index;
+            if actually_skipped > 0 {
+                assert_eq!(actually_skipped, naive_count);
+                assert_eq!(
+                    observation.pending_after,
+                    observation.pending_before[naive_count..]
+                );
+                if observation
+                    .pending_before
+                    .iter()
+                    .any(|&(doc, _)| doc == observation.target)
+                {
+                    assert_eq!(observation.pending_after[0].0, observation.target);
+                }
+            } else {
+                assert_eq!(observation.pending_after, observation.pending_before);
+            }
+            assert!(observation.lo <= observation.trigger);
+            assert!(observation.trigger < observation.target);
+            assert!(observation.target <= observation.hi);
+            assert!(observation.optional_doc >= observation.target);
+            assert!(observation.driver_doc >= observation.hi);
+            assert!(observation.batch_index < observation.batch_len);
+            assert!(observation.next_index <= observation.batch_len);
+            if observation.next_index != observation.batch_index {
+                assert!(observation.next_index >= observation.batch_index + 2);
+                assert!(
+                    Score::from_bits(observation.bound.unwrap())
+                        <= Score::from_bits(observation.threshold)
+                );
+            }
+        }
+        (actual, observations)
+    }
+
+    #[test]
+    fn required_gap_preserves_full_owned_batches_exclusive_end_and_literal_scores() {
+        for num_terms in [3, 32] {
+            for native in [false, true] {
+                for optional_end in [128, 129, TERMINATED] {
+                    let optional_docs = if optional_end == TERMINATED {
+                        vec![0, 64]
+                    } else {
+                        vec![0, 64, optional_end]
+                    };
+                    let (scorers, boundary) =
+                        required_gap_fixture(num_terms, 128, &optional_docs, native);
+                    for reversed in [false, true] {
+                        let ordered = if reversed {
+                            scorers.iter().rev().cloned().collect()
+                        } else {
+                            scorers.clone()
+                        };
+                        let (accepted, observations) =
+                            check_required_gap_rule(ordered.clone(), boundary, |_, _, current| {
+                                current
+                            });
+                        assert!(accepted.iter().any(|&(doc, _)| doc == 64));
+                        assert!(
+                            observations.iter().any(|observation| {
+                                observation.trigger == 1
+                                    && observation.target == 64
+                                    && observation.next_index > observation.batch_index
+                                    && observation.batch_len == 128
+                                    && observation.driver_doc > 64
+                            }),
+                            "{observations:?}"
+                        );
+                        assert!(
+                            observations.iter().any(|observation| {
+                                observation.trigger == 65
+                                    && observation.target == observation.hi
+                                    && observation.optional_doc == optional_end
+                                    && observation.next_index == observation.batch_len
+                            }),
+                            "{observations:?}"
+                        );
+                        // Full exhaustive callback/score-bit traces for actual
+                        // Top1/Top10 threshold schedules and strict neighbors.
+                        for threshold in [boundary.next_down(), boundary, boundary.next_up()] {
+                            for limit in [0, 1, 10] {
+                                check(ordered.clone(), 2048, threshold, limit);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
