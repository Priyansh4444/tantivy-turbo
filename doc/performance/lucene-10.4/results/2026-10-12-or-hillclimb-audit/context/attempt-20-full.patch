+    #[test]
+    fn required_gap_cache_rechecks_equality_after_real_threshold_growth_and_deletions() {
+        for num_terms in [3, 32] {
+            for native in [false, true] {
+                let (scorers, boundary) =
+                    required_gap_fixture(num_terms, 128, &[0, 32, 64, 128], native);
+                for reversed in [false, true] {
+                    let ordered = if reversed {
+                        scorers.iter().rev().cloned().collect()
+                    } else {
+                        scorers.clone()
+                    };
+                    // Deleted early matches withhold the raise. Only the real
+                    // callback at64 changes the live threshold to exact bound.
+                    let (accepted, observations) = check_required_gap_rule(
+                        ordered,
+                        boundary.next_down(),
+                        |doc, _, current| {
+                            if doc >= 64 {
+                                current.max(boundary)
+                            } else {
+                                current
+                            }
+                        },
+                    );
+                    assert!(accepted.iter().any(|&(doc, _)| doc == 0));
+                    assert!(accepted.iter().any(|&(doc, _)| doc == 32));
+                    assert!(accepted.iter().any(|&(doc, _)| doc == 64));
+                    assert!(
+                        observations.iter().any(|observation| {
+                            observation.trigger == 1
+                                && observation.cache_built
+                                && observation.bound == Some(boundary.to_bits())
+                                && observation.next_index == observation.batch_index
+                        }),
+                        "{observations:?}"
+                    );
+                    assert!(
+                        observations.iter().any(|observation| {
+                            observation.trigger == 65
+                                && !observation.cache_built
+                                && observation.bound == Some(observation.threshold)
+                                && observation.next_index == observation.batch_len
+                        }),
+                        "{observations:?}"
+                    );
+                }
+            }
+        }
+    }
