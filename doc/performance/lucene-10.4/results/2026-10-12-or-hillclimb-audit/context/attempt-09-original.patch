+    fn assert_heap_evidence(evidence: &HeapEvidence, originals: &[TermScorer]) {
+        for fill in &evidence.fills {
+            assert!(fill.slot < originals.len());
+            assert!(fill.docs.len() <= POSTING_BATCH);
+            assert_eq!(fill.docs.len(), fill.leaves.len());
+            assert!(fill.docs.iter().all(|&doc| fill.lo <= doc && doc < fill.hi));
+            assert!(fill.docs.windows(2).all(|pair| pair[0] < pair[1]));
+            assert!(fill.docs.is_empty() || fill.unread > *fill.docs.last().unwrap());
+            assert!(!fill.docs.is_empty() || fill.unread >= fill.hi);
+            for (&doc, &leaf) in fill.docs.iter().zip(&fill.leaves) {
+                let mut scorer = originals[fill.ordinal].clone();
+                assert_eq!(scorer.seek(doc), doc);
+                assert_eq!(leaf.to_bits(), scorer.score().to_bits());
+            }
+        }
+        for candidate in &evidence.candidates {
+            assert!(candidate.ordinals.len() >= 2);
+            assert!(candidate.lo <= candidate.doc && candidate.doc < candidate.hi);
+            assert_eq!(candidate.incoming_leaves.len(), originals.len());
+            assert_eq!(candidate.unread.len(), candidate.ordinals.len());
+            let mut expected_row = vec![0.0; originals.len()];
+            let mut expected_slots = Vec::new();
+            let mut known = 0.0f64;
+            for (slot, &ordinal) in candidate.ordinals.iter().enumerate() {
+                let mut scorer = originals[ordinal].clone();
+                if scorer.seek(candidate.doc) == candidate.doc {
+                    let leaf = scorer.score();
+                    expected_row[ordinal] = leaf;
+                    expected_slots.push(slot);
+                    known += f64::from(leaf);
+                    scorer.advance();
+                }
+                // Independent postings establish that no absent head can hide
+                // an unconsumed essential candidate inside the certificate.
+                let expected_head = (scorer.doc() < candidate.hi).then_some(scorer.doc());
+                let actual_head = candidate
+                    .heads
+                    .iter()
+                    .find(|&&(_, head_slot)| head_slot == slot)
+                    .map(|&(doc, _)| doc);
+                assert_eq!(actual_head, expected_head);
+            }
+            assert_eq!(candidate.matched_slots, expected_slots);
+            assert_eq!(candidate.known.to_bits(), known.to_bits());
+            assert_eq!(
+                candidate
+                    .incoming_leaves
+                    .iter()
+                    .map(|leaf| leaf.to_bits())
+                    .collect::<Vec<_>>(),
+                expected_row
+                    .iter()
+                    .map(|leaf| leaf.to_bits())
+                    .collect::<Vec<_>>(),
+            );
+            let mut head_slots = Vec::new();
+            for (index, &(doc, slot)) in candidate.heads.iter().enumerate() {
+                assert!(candidate.doc < doc && doc < candidate.hi);
+                assert!(slot < candidate.ordinals.len());
+                assert!(!head_slots.contains(&slot));
+                head_slots.push(slot);
+                if index > 0 {
+                    assert!(candidate.heads[(index - 1) / 2] <= (doc, slot));
+                }
+            }
+        }
+    }
