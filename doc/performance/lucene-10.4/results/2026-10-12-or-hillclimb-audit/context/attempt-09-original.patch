+const POSTING_BATCH: usize = crate::postings::compression::COMPRESSION_BLOCK_SIZE;
+const MAX_OR_TERMS: usize = 32;
+
+struct EssentialLeafBuffer {
+    docs: [DocId; POSTING_BATCH],
+    leaves: [Score; POSTING_BATCH],
+    next: usize,
+    len: usize,
+}
+
+#[derive(Clone, Copy)]
+struct Head {
+    doc: DocId,
+    slot: usize,
+}
+
+impl Head {
+    fn precedes(self, other: Self) -> bool {
+        (self.doc, self.slot) < (other.doc, other.slot)
     }
 }
 
+struct EssentialMergeScratch {
+    buffers: Vec<EssentialLeafBuffer>,
+    heap: [Head; MAX_OR_TERMS],
+}
+
+/// A fixed certified suffix owns retained leaves until its heap drains. Actual
+/// ClauseState docs remain first unread, even when all are beyond pending hits.
+struct EssentialRegion<'a> {
+    scratch: &'a mut EssentialMergeScratch,
+    essentials: &'a mut [ClauseState],
+    floor: DocId,
+    hi: DocId,
+    heap_len: usize,
+}
+
+// Mutually exclusive metadata borrows keep one optional/publication body and
+// leave the accepted single-essential scored batch protocol unchanged.
+enum EssentialReplay<'a> {
+    Single(&'a mut ClauseState),
+    Heap(EssentialRegion<'a>),
+}
+
+impl EssentialMergeScratch {
+    fn new(num_terms: usize) -> Self {
+        Self {
+            buffers: (0..num_terms)
+                .map(|_| EssentialLeafBuffer {
+                    docs: [0; POSTING_BATCH],
+                    leaves: [0.0; POSTING_BATCH],
+                    next: 0,
+                    len: 0,
+                })
+                .collect(),
+            heap: [Head { doc: 0, slot: 0 }; MAX_OR_TERMS],
+        }
+    }
+
+    fn region<'a>(
+        &'a mut self,
+        essentials: &'a mut [ClauseState],
+        lo: DocId,
+        hi: DocId,
+        scorers: &mut [TermScorer],
+        shared: &mut ScoredTermBatch,
+    ) -> EssentialRegion<'a> {
+        debug_assert!((2..=MAX_OR_TERMS).contains(&essentials.len()));
+        debug_assert!(essentials.len() <= self.buffers.len());
+        debug_assert!(lo < hi);
+        let mut region = EssentialRegion {
+            scratch: self,
+            essentials,
+            floor: lo,
+            hi,
+            heap_len: 0,
+        };
+        for slot in 0..region.essentials.len() {
+            let buffer = &mut region.scratch.buffers[slot];
+            debug_assert_eq!(buffer.next, buffer.len, "previous region must drain");
+            buffer.next = 0;
+            buffer.len = 0;
+            region.refill(slot, scorers, shared);
+            if let Some(head) = region.head(slot) {
+                region.scratch.heap[region.heap_len] = head;
+                region.heap_len += 1;
+            }
+        }
+        for parent in (0..region.heap_len / 2).rev() {
+            region.sift_down(parent);
+        }
+        region
+    }
+}
+
+impl EssentialRegion<'_> {
+    fn refill(&mut self, slot: usize, scorers: &mut [TermScorer], shared: &mut ScoredTermBatch) {
+        let lo = self.floor;
+        let hi = self.hi;
+        let buffer = &mut self.scratch.buffers[slot];
+        debug_assert_eq!(buffer.next, buffer.len, "only a drained owner may refill");
+        buffer.next = 0;
+        buffer.len = 0;
+        let clause = &mut self.essentials[slot];
+        if clause.doc >= hi {
+            return;
+        }
+        let previous_doc = clause.doc;
+        let floor = lo.max(previous_doc);
+        let len = clause.fill_scored_batch(scorers, floor, hi, shared);
+        debug_assert!(len <= POSTING_BATCH);
+        debug_assert!(clause.doc > previous_doc);
+        debug_assert!(len > 0 || clause.doc >= hi);
+        debug_assert!(shared.docs[..len]
+            .iter()
+            .all(|&doc| floor <= doc && doc < hi));
+        debug_assert!(shared.docs[..len].windows(2).all(|pair| pair[0] < pair[1]));
+        buffer.docs[..len].copy_from_slice(&shared.docs[..len]);
+        buffer.leaves[..len].copy_from_slice(&shared.scores[..len]);
+        buffer.len = len;
+        #[cfg(test)]
+        HEAP_EVIDENCE.with(|evidence| {
+            if let Some(evidence) = evidence.borrow_mut().as_mut() {
+                evidence.fills.push(HeapFillEvidence {
+                    lo,
+                    hi,
+                    slot,
+                    ordinal: clause.ordinal,
+                    docs: buffer.docs[..len].to_vec(),
+                    leaves: buffer.leaves[..len].to_vec(),
+                    unread: clause.doc,
+                });
+            }
+        });
+    }
+
+    fn head(&self, slot: usize) -> Option<Head> {
+        let buffer = &self.scratch.buffers[slot];
+        (buffer.next < buffer.len).then(|| Head {
+            doc: buffer.docs[buffer.next],
+            slot,
+        })
+    }
+
+    fn sift_down(&mut self, mut parent: usize) {
+        let head = self.scratch.heap[parent];
+        loop {
+            let left = 2 * parent + 1;
+            if left >= self.heap_len {
+                break;
+            }
+            let right = left + 1;
+            let child = if right < self.heap_len
+                && self.scratch.heap[right].precedes(self.scratch.heap[left])
+            {
+                right
+            } else {
+                left
+            };
+            if !self.scratch.heap[child].precedes(head) {
+                break;
+            }
+            self.scratch.heap[parent] = self.scratch.heap[child];
+            parent = child;
+        }
+        self.scratch.heap[parent] = head;
+    }
+
+    fn replace_or_remove_top(&mut self, next: Option<Head>) {
+        if let Some(next) = next {
+            self.scratch.heap[0] = next;
+        } else {
+            self.heap_len -= 1;
+            if self.heap_len == 0 {
+                return;
+            }
+            self.scratch.heap[0] = self.scratch.heap[self.heap_len];
+        }
+        self.sift_down(0);
+    }
+
+    fn next_candidate(
+        &mut self,
+        scorers: &mut [TermScorer],
+        shared: &mut ScoredTermBatch,
+        row: &mut [Score],
+    ) -> Option<(DocId, f64)> {
+        if self.heap_len == 0 {
+            debug_assert!(self.essentials.iter().all(|clause| clause.doc >= self.hi));
+            debug_assert!(self.scratch.buffers[..self.essentials.len()]
+                .iter()
+                .all(|buffer| buffer.next == buffer.len));
+            return None;
+        }
+        let doc = self.scratch.heap[0].doc;
+        debug_assert!(self.floor <= doc && doc < self.hi);
+        row.fill(0.0);
+        let mut known = 0.0f64;
+        #[cfg(test)]
+        let mut matched_slots = Vec::new();
+        while self.heap_len > 0 && self.scratch.heap[0].doc == doc {
+            let slot = self.scratch.heap[0].slot;
+            let buffer = &mut self.scratch.buffers[slot];
+            let leaf = buffer.leaves[buffer.next];
+            row[self.essentials[slot].ordinal] = leaf;
+            known += f64::from(leaf);
+            #[cfg(test)]
+            matched_slots.push(slot);
+            buffer.next += 1;
+            if buffer.next == buffer.len {
+                self.refill(slot, scorers, shared);
+            }
+            let next = self.head(slot);
+            debug_assert!(next.is_none_or(|head| head.doc > doc));
+            self.replace_or_remove_top(next);
+        }
+        #[cfg(test)]
+        HEAP_EVIDENCE.with(|evidence| {
+            if let Some(evidence) = evidence.borrow_mut().as_mut() {
+                evidence.candidates.push(HeapCandidateEvidence {
+                    lo: self.floor,
+                    hi: self.hi,
+                    doc,
+                    ordinals: self
+                        .essentials
+                        .iter()
+                        .map(|clause| clause.ordinal)
+                        .collect(),
+                    matched_slots,
+                    incoming_leaves: row.to_vec(),
+                    known,
+                    unread: self.essentials.iter().map(|clause| clause.doc).collect(),
+                    heads: self.scratch.heap[..self.heap_len]
+                        .iter()
+                        .map(|head| (head.doc, head.slot))
+                        .collect(),
+                });
+            }
+        });
+        Some((doc, known))
+    }
+}
+
+impl Drop for EssentialRegion<'_> {
+    fn drop(&mut self) {
+        // Preserve the original panic diagnostic if an invariant fails mid-drain.
+        #[cfg(debug_assertions)]
+        if !std::thread::panicking() {
+            debug_assert_eq!(
+                self.heap_len, 0,
+                "pending leaves must drain before a new certificate"
+            );
+        }
+    }
+}
