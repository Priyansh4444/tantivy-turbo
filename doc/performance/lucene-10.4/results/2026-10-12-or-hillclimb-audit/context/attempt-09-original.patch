+    #[test]
+    fn posting_heap_runner_up_ties_below_hi_and_at_next_region_boundary() {
+        let norms = vec![1; 512];
+        for length in [127, 128, 129] {
+            let lead: Vec<_> = (0..length).map(|doc| (doc, 1 + doc % 7)).collect();
+            let last = length - 1;
+            let other = [(last, 3), (last + 1, 4), (300, 5)];
+            let scorers = vec![
+                fixture(&lead, &norms, 0.7),
+                fixture(&other, &norms, 0.3),
+                fixture(&other, &norms, 0.5),
+            ];
+            let (accepted, evidence) = observed_heap_check(scorers.clone(), 512, 0.0, 0);
+            assert_eq!(accepted.iter().filter(|&&(doc, _)| doc == last).count(), 1);
+            assert_eq!(
+                accepted.iter().filter(|&&(doc, _)| doc == last + 1).count(),
+                1
+            );
+            assert!(accepted.iter().any(|&(doc, _)| doc == 300));
+            assert!(evidence
+                .candidates
+                .iter()
+                .any(|candidate| candidate.doc == last && candidate.matched_slots.len() == 3));
+            for limit in [1, 10] {
+                observed_heap_check(scorers.clone(), 512, 0.0, limit);
+            }
+
+            // Exercise the owner directly at an explicit certificate edge.
+            // All clauses remain essential; the lead's 127/128/129-posting stream
+            // meets both runners once below hi, then exactly at next region lo.
+            let lead: Vec<_> = (0..length)
+                .map(|doc| (doc, 1 + doc % 7))
+                .chain([(length, 8), (300, 9)])
+                .collect();
+            let other = [(last, 3), (length, 4), (300, 5)];
+            let mut scorers = vec![
+                fixture(&lead, &norms, 0.7),
+                fixture(&other, &norms, 0.3),
+                fixture(&other, &norms, 0.5),
+            ];
+            let originals = scorers.clone();
+            let mut clauses: Vec<_> = [1, 2, 0]
+                .into_iter()
+                .map(|ordinal| ClauseState {
+                    ordinal,
+                    global_max: scorers[ordinal].max_score(),
+                    cost: scorers[ordinal].size_hint(),
+                    doc: scorers[ordinal].doc(),
+                    local_max: scorers[ordinal].max_score(),
+                })
+                .collect();
+            let mut scratch = EssentialMergeScratch::new(3);
+            let mut shared = ScoredTermBatch::new();
+            let mut row = vec![0.0; 3];
+            let mut published = Vec::new();
+            HEAP_EVIDENCE.with(|evidence| *evidence.borrow_mut() = Some(HeapEvidence::default()));
+            for (lo, hi) in [(0, length), (length, 512)] {
+                let mut region = scratch.region(&mut clauses, lo, hi, &mut scorers, &mut shared);
+                while let Some((doc, _)) =
+                    region.next_candidate(&mut scorers, &mut shared, &mut row)
+                {
+                    let score = row.iter().map(|&leaf| f64::from(leaf)).sum::<f64>() as Score;
+                    published.push((doc, score.to_bits()));
+                }
+            }
+            let evidence = HEAP_EVIDENCE.with(|evidence| evidence.borrow_mut().take().unwrap());
+            assert_heap_evidence(&evidence, &originals);
+            for edge in [last, length] {
+                assert_eq!(published.iter().filter(|&&(doc, _)| doc == edge).count(), 1);
+                assert!(
+                    evidence
+                        .candidates
+                        .iter()
+                        .any(|candidate| candidate.doc == edge
+                            && candidate.matched_slots == [0, 1, 2])
+                );
+            }
+            assert!(evidence
+                .fills
+                .iter()
+                .filter(|fill| fill.lo == 0)
+                .all(|fill| fill.docs.iter().all(|&doc| doc < length)));
+            assert!(evidence
+                .candidates
+                .iter()
+                .any(|candidate| candidate.doc == last - 1
+                    && candidate.heads.iter().any(|&(doc, _)| doc == last)));
+            let expected = trace(0.0, 0, |callback| {
+                let mut union = BufferedUnionScorer::build(originals, SumCombiner::default, 512);
+                for_each_pruning_scorer(&mut union, 0.0, callback);
+            });
+            assert_eq!(published, expected);
+            assert!(evidence
+                .candidates
+                .iter()
+                .find(|candidate| candidate.doc == length)
+                .unwrap()
+                .heads
+                .iter()
+                .any(|&(doc, _)| doc == 300));
+        }
+    }
