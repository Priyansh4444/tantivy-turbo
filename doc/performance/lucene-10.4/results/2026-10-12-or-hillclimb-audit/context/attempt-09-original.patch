+    #[test]
+    fn posting_heap_current_threshold_and_simulated_collector_deletion_rejection() {
+        let norms = vec![1; 128];
+        let postings = [(0, 1), (7, 3), (63, 5), (64, 8), (127, 20)];
+        let scorers = vec![
+            fixture(&postings, &norms, 0.3),
+            fixture(&postings, &norms, 0.5),
+            fixture(&postings, &norms, 0.001),
+        ];
+        for limit in [0, 1, 10] {
+            let (_, evidence) = observed_heap_check(scorers.clone(), 128, 0.1, limit);
+            assert!(evidence
+                .candidates
+                .iter()
+                .any(|candidate| candidate.matched_slots.len() >= 2));
+        }
+        let run = |heap: bool| {
+            let mut accepted = Vec::new();
+            let mut current: Score = 0.1;
+            let mut callback = |doc, score: Score| {
+                accepted.push((doc, score.to_bits()));
+                if doc != 0 && doc != 63 {
+                    current = current.max(score);
+                }
+                current
+            };
+            if heap {
+                or_maxscore(scorers.clone(), 128, 0.1, &mut callback);
+            } else {
+                let mut union =
+                    BufferedUnionScorer::build(scorers.clone(), SumCombiner::default, 128);
+                for_each_pruning_scorer(&mut union, 0.1, &mut callback);
+            }
+            accepted
+        };
+        assert_eq!(run(true), run(false));
+        assert_eq!(
+            run(true).iter().map(|&(doc, _)| doc).collect::<Vec<_>>(),
+            [0, 7, 63, 64, 127]
+        );
+    }
