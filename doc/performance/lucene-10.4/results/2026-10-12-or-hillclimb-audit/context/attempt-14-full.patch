+    #[test]
+    fn contribution_masks_reset_for_optional_probes_and_pending_single_batches() {
+        let norms = vec![1; 2048];
+        let matches = |doc: DocId, ordinal| match ordinal {
+            0 => ![4, 12].contains(&(doc % 16)),
+            1 => ![0, 12].contains(&(doc % 16)),
+            _ => doc % 4 == 0,
+        };
+        for native in [false, true] {
+            let scorers: Vec<_> = [0.01, 0.02, 1.0]
+                .iter()
+                .enumerate()
+                .map(|(ordinal, &boost)| {
+                    let postings: Vec<_> = (0..2048)
+                        .filter(|&doc| matches(doc, ordinal))
+                        .map(|doc| (doc, if ordinal == 2 && doc == 1920 { 30 } else { 1 }))
+                        .collect();
+                    let weight = if native {
+                        Bm25Weight::for_native_block_bounds(1.0).boost_by(boost)
+                    } else {
+                        Bm25Weight::new_without_explain(1.0, 1.0).boost_by(boost)
+                    };
+                    assert!(weight.has_safe_score_bounds() && weight.max_score() > 0.0);
+                    TermScorer::create_for_test(&postings, &norms, weight)
+                })
+                .collect();
+            CONTRIBUTION_STATES.with(|states| *states.borrow_mut() = Some(Vec::new()));
+            BATCH_LENGTHS.with(|lengths| *lengths.borrow_mut() = Some(Vec::new()));
+            let accepted = check(scorers.clone(), 2048, 0.1, 0);
+            let states = CONTRIBUTION_STATES.with(|states| states.borrow_mut().take().unwrap());
+            let lengths = BATCH_LENGTHS.with(|lengths| lengths.borrow_mut().take().unwrap());
+            assert_eq!(accepted.len(), 512);
+            assert_eq!(states.len(), 512);
+            assert!(states.iter().all(|state| state.2 && state.3));
+            assert!(lengths.contains(&128));
+            for &(doc, _, _, _, mask) in &states {
+                let expected_mask = (0..3).fold(0u32, |mask, ordinal| {
+                    mask | if matches(doc, ordinal) {
+                        1u32 << ordinal
+                    } else {
+                        0
+                    }
+                });
+                assert_eq!(mask, expected_mask, "doc={doc} native={native}");
+            }
+            for mask in [0b100, 0b101, 0b110, 0b111] {
+                assert!(states.iter().any(|state| state.4 == mask));
+            }
+            assert!(states.windows(2).any(|pair| pair[0].1 != pair[1].1));
+            CONTRIBUTION_STATES.with(|states| *states.borrow_mut() = Some(Vec::new()));
+            let growing = check(scorers, 2048, 0.1, 1);
+            let states = CONTRIBUTION_STATES.with(|states| states.borrow_mut().take().unwrap());
+            assert_eq!(growing.last().unwrap().0, 1920);
+            assert!(
+                states.iter().any(|state| !state.3),
+                "must reset after early optional pruning"
+            );
+            assert!(states.iter().any(|state| state.3 && state.0 > 0));
+            // A partially probed, pruned candidate may mark only a subset of
+            // its actual matches. It must never inherit another doc's bit.
+            for &(doc, _, _, _, mask) in &states {
+                let actual_mask = (0..3).fold(0u32, |mask, ordinal| {
+                    mask | if matches(doc, ordinal) {
+                        1u32 << ordinal
+                    } else {
+                        0
+                    }
+                });
+                assert_eq!(mask & !actual_mask, 0, "doc={doc} native={native}");
+            }
+        }
+    }
