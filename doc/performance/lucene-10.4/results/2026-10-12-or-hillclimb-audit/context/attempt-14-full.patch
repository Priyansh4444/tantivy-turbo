+    #[test]
+    fn contribution_masks_reset_across_scalar_regions_at_32_terms() {
+        let norms = vec![1; 1024];
+        let matches = |doc: DocId, ordinal: usize| match doc % 4 {
+            0 => true,
+            1 => ordinal == 31,
+            2 => ordinal == 0,
+            _ => ordinal % 2 == 1,
+        };
+        let mut leaves = [2.0f32.powi(-60); 32];
+        leaves[0] = 1.0;
+        leaves[1] = 2.0f32.powi(-24);
+        leaves[2] = 2.0f32.powi(-53);
+        leaves[31] = 2.0f32.powi(-53);
+        let scorers: Vec<_> = (0..32)
+            .map(|ordinal| {
+                let postings: Vec<_> = (0..1024)
+                    .filter(|&doc| matches(doc, ordinal))
+                    .map(|doc| (doc, 1))
+                    .collect();
+                let scorer = fixture(&postings, &norms, leaves[ordinal]);
+                assert_eq!(scorer.clone().score().to_bits(), leaves[ordinal].to_bits());
+                scorer
+            })
+            .collect();
+        let mut full_scores = Vec::new();
+        for reversed in [false, true] {
+            let order: Vec<_> = if reversed {
+                (0..32).rev().collect()
+            } else {
+                (0..32).collect()
+            };
+            let ordered: Vec<_> = order.iter().map(|&i| scorers[i].clone()).collect();
+            CONTRIBUTION_STATES.with(|states| *states.borrow_mut() = Some(Vec::new()));
+            let accepted = check(ordered.clone(), 1024, 0.0, 0);
+            let states = CONTRIBUTION_STATES.with(|states| states.borrow_mut().take().unwrap());
+            let expected: Vec<_> = (0..1024)
+                .map(|doc| {
+                    let mut sum = 0.0f64;
+                    for &ordinal in &order {
+                        if matches(doc, ordinal) {
+                            sum += f64::from(leaves[ordinal]);
+                        }
+                    }
+                    (doc, (sum as Score).to_bits())
+                })
+                .collect();
+            assert_eq!(accepted, expected);
+            assert_eq!(states.len(), 1024);
+            assert!(states.iter().all(|state| !state.2 && state.3));
+            for &(doc, _, _, _, mask) in &states {
+                let expected_mask = order.iter().enumerate().fold(0u32, |mask, (i, &ordinal)| {
+                    mask | if matches(doc, ordinal) { 1u32 << i } else { 0 }
+                });
+                assert_eq!(mask, expected_mask, "doc={doc} reversed={reversed}");
+            }
+            assert!(states.iter().any(|state| state.4 == u32::MAX));
+            if !reversed {
+                assert!(states.iter().any(|state| state.4 == 1u32 << 31));
+            }
+            let mut floors: Vec<_> = states.iter().map(|state| state.1).collect();
+            floors.dedup();
+            assert!(floors.len() >= 3, "must cross local region boundaries");
+            let full_score = Score::from_bits(expected[0].1);
+            full_scores.push(full_score.to_bits());
+            for threshold in [full_score.next_down(), full_score, full_score.next_up()] {
+                for limit in [0, 1, 10] {
+                    check(ordered.clone(), 1024, threshold, limit);
+                }
+            }
+        }
+        assert_ne!(
+            full_scores[0], full_scores[1],
+            "incoming-order midpoint must be sensitive"
+        );
+    }
