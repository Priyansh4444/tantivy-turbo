+    #[test]
+    fn local_priority_reversals_reconcile_promoted_stale_decoders() {
+        let norms = vec![1; 512];
+        let a: Vec<_> = (0..384)
+            .map(|doc| (doc, if (128..256).contains(&doc) { 100 } else { 1 }))
+            .collect();
+        let b: Vec<_> = (0..384)
+            .map(|doc| (doc, if (128..256).contains(&doc) { 1 } else { 100 }))
+            .collect();
+        let rare = [(0, 1), (383, 1)];
+        // The dense clauses tie globally. Their local bounds reverse at each
+        // full-block boundary, so A is optional, then B, then A again. The
+        // newly essential decoder still holds the preceding region's last doc.
+        let scorers = vec![
+            fixture(&a, &norms, 1.0),
+            fixture(&b, &norms, 1.0),
+            fixture(&rare, &norms, 4.0),
+        ];
+        LOCAL_PARTITIONS.with(|partitions| *partitions.borrow_mut() = Some(Vec::new()));
+        let accepted = check(scorers.clone(), 512, 1.1, 0);
+        let partitions =
+            LOCAL_PARTITIONS.with(|partitions| partitions.borrow_mut().take().unwrap());
+        assert_eq!(
+            accepted.iter().map(|&(doc, _)| doc).collect::<Vec<_>>(),
+            (0..384).collect::<Vec<_>>()
+        );
+        for (lo, hi, optional, promoted) in [(0, 128, 0, 1), (128, 256, 1, 0), (256, 384, 0, 1)] {
+            let partition = partitions
+                .iter()
+                .find(|partition| partition.lo == lo)
+                .unwrap();
+            assert_eq!(partition.hi, hi);
+            assert_eq!(partition.globally_optional, 0);
+            let optionals = &partition.ordinals[..partition.first_essential];
+            let essentials = &partition.ordinals[partition.first_essential..];
+            assert!(
+                optionals.contains(&optional),
+                "lo={lo}: {:?}",
+                partition.ordinals
+            );
+            assert!(!optionals.contains(&promoted));
+            assert!(essentials.contains(&promoted));
+            if lo > 0 {
+                assert_eq!(partition.decoded_docs[promoted], lo - 1);
+            }
+        }
+        // The first Top-1 hit raises the threshold enough to certify both
+        // dense globals. Their fixed prefix must stay optional while the rare
+        // tail widens across the remaining dense physical block boundaries.
+        LOCAL_PARTITIONS.with(|partitions| *partitions.borrow_mut() = Some(Vec::new()));
+        let top_one = check(scorers.clone(), 512, 1.1, 1);
+        let partitions =
+            LOCAL_PARTITIONS.with(|partitions| partitions.borrow_mut().take().unwrap());
+        assert_eq!(top_one.iter().map(|&(doc, _)| doc).collect::<Vec<_>>(), [0]);
+        let widened = partitions
+            .iter()
+            .find(|partition| partition.globally_optional == 2)
+            .unwrap();
+        assert_eq!(&widened.ordinals[..2], &[0, 1]);
+        assert!(widened.first_essential >= 2);
+        assert_eq!((widened.lo, widened.hi), (128, 512));
+        // Growing heap thresholds and incoming-order permutations still use
+        // independent whole callback traces, not only final heap membership.
+        check(scorers.clone(), 512, 1.1, 10);
+        for limit in [1, 10] {
+            check(scorers.iter().rev().cloned().collect(), 512, 1.1, limit);
+        }
+    }
