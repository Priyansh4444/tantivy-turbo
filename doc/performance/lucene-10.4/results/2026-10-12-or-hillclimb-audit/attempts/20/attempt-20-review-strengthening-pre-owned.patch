             REQUIRED_GAPS.with(|observations| observations.borrow_mut().take().unwrap());
         assert_eq!(actual, expected);
         for observation in &observations {
+            assert_eq!(observation.num_terms, scorers.len());
+            assert_eq!(observation.rank + 2, observation.num_terms);
+            assert_eq!(observation.lower_before, observation.lower_after);
+            assert!(observation
+                .lower_before
+                .iter()
+                .all(|&(mirror, real)| mirror == real));
+            assert_eq!(observation.driver_before, observation.driver_after);
+            assert_eq!(observation.driver_before.0, observation.driver_before.1);
+            assert_eq!(observation.driver_before.0, observation.driver_doc);
+            assert_eq!(
+                observation.pending_before.len(),
+                observation.batch_len - observation.batch_index
+            );
+            assert_eq!(observation.pending_before[0].0, observation.trigger);
+            assert!(observation
+                .pending_before
+                .windows(2)
+                .all(|pair| pair[0].0 < pair[1].0));
+            assert!(observation
+                .pending_before
+                .iter()
+                .all(|&(doc, _)| doc < observation.hi));
+            let naive_count = observation
+                .pending_before
+                .iter()
+                .take_while(|&&(doc, _)| doc < observation.target)
+                .count();
+            let actually_skipped = observation.next_index - observation.batch_index;
+            if actually_skipped > 0 {
+                assert_eq!(actually_skipped, naive_count);
+                assert_eq!(
+                    observation.pending_after,
+                    observation.pending_before[naive_count..]
+                );
+                if observation
+                    .pending_before
+                    .iter()
+                    .any(|&(doc, _)| doc == observation.target)
+                {
+                    assert_eq!(observation.pending_after[0].0, observation.target);
+                }
+            } else {
+                assert_eq!(observation.pending_after, observation.pending_before);
+            }
             assert!(observation.lo <= observation.trigger);
