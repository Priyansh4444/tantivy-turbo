+    #[test]
+    fn two_essential_min_preserves_equal_disjoint_exhausted_and_dynamic_traces() {
+        let norms = vec![1; 1024];
+        let dense: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let left: Vec<_> = (0..257)
+            .map(|i| (2 * i, if i == 240 { 30 } else { 1 }))
+            .collect();
+        let mut right: Vec<_> = (0..129).map(|i| (2 * i + 1, 1)).collect();
+        right.extend([(0, 1), (128, 1), (256, 1), (700, 50)]);
+        right.sort_unstable_by_key(|&(doc, _)| doc);
+        for num_terms in [3, 32] {
+            // The weak dense prefix fits .05 for either arity. Each strong
+            // serialized scorer independently exceeds it, leaving precisely
+            // two essential clauses in the fixed-threshold traversal.
+            let mut scorers: Vec<_> = (0..num_terms - 2)
+                .map(|_| fixture(&dense, &norms, 0.0001))
+                .collect();
+            scorers.push(fixture(&left, &norms, 1.0));
+            scorers.push(fixture(&right, &norms, 1.25));
+            for reversed in [false, true] {
+                let ordered: Vec<_> = if reversed {
+                    scorers.iter().rev().cloned().collect()
+                } else {
+                    scorers.clone()
+                };
+                TWO_ESSENTIAL_HEADS.with(|heads| *heads.borrow_mut() = Some(Vec::new()));
+                let accepted = check(ordered.clone(), 1024, 0.05, 0);
+                let heads = TWO_ESSENTIAL_HEADS.with(|heads| heads.borrow_mut().take().unwrap());
+                assert!(!heads.is_empty(), "arity={num_terms} reversed={reversed}");
+                for &(left, right, doc, _) in &heads {
+                    // Independent two-element sorted oracle checks the chosen
+                    // candidate, including the terminal break observation.
+                    let mut sorted = [left, right];
+                    sorted.sort_unstable();
+                    assert_eq!(doc, sorted[0]);
+                }
+                assert!(heads
+                    .iter()
+                    .any(|&(left, right, _, hi)| left == right && left < hi));
+                assert!(heads
+                    .iter()
+                    .any(|&(left, right, _, hi)| left != right && left < hi && right < hi));
+                assert!(heads.iter().any(|&(left, right, doc, hi)| {
+                    (left == TERMINATED || right == TERMINATED) && doc == 700 && doc < hi
+                }));
+                assert!(heads.iter().any(|&(left, right, doc, _)| {
+                    left == TERMINATED && right == TERMINATED && doc == TERMINATED
+                }));
+                assert!(accepted.iter().any(|&(doc, _)| doc == 512));
+                assert_eq!(accepted.last().unwrap().0, 700);
+
+                for limit in [1, 10] {
+                    check(ordered.clone(), 1024, 0.05, limit);
+                }
+                // Derive a strict tie from literal canonical leaves, without
+                // consulting local certificates or the new minimum route.
+                let tie = ordered
+                    .iter()
+                    .cloned()
+                    .map(|mut scorer| {
+                        if scorer.seek(2) == 2 {
+                            f64::from(scorer.score())
+                        } else {
+                            0.0
+                        }
+                    })
+                    .sum::<f64>() as Score;
+                for threshold in [tie.next_down(), tie, tie.next_up()] {
+                    let strict = check(ordered.clone(), 1024, threshold, 0);
+                    assert_eq!(strict.iter().any(|&(doc, _)| doc == 2), threshold < tie);
+                }
+                // Deletion ownership is represented by leaving the callback
+                // threshold unchanged for docs 0 and 128. Keep every callback
+                // and its score bits, then compare the independent union.
+                let run = |optimized: bool| {
+                    let mut accepted = Vec::new();
+                    let mut current: Score = 0.05;
+                    let mut callback = |doc, score: Score| {
+                        accepted.push((doc, score.to_bits()));
+                        if doc != 0 && doc != 128 {
+                            current = current.max(score);
+                        }
+                        current
+                    };
+                    if optimized {
+                        or_maxscore(ordered.clone(), 1024, 0.05, &mut callback);
+                    } else {
+                        let mut union =
+                            BufferedUnionScorer::build(ordered.clone(), SumCombiner::default, 1024);
+                        for_each_pruning_scorer(&mut union, 0.05, &mut callback);
+                    }
+                    assert!(accepted.windows(2).all(|pair| pair[0].0 < pair[1].0));
+                    accepted
+                };
+                let deleted = run(true);
+                assert_eq!(deleted, run(false));
+                assert_eq!(deleted.first().unwrap().0, 0);
+                assert!(deleted.iter().any(|&(doc, _)| doc == 128));
+                assert!(deleted.iter().any(|&(doc, _)| doc == 256));
+                assert_eq!(deleted.last().unwrap().0, 700);
+            }
+        }
+    }
