+    #[test]
+    fn capped_native_expansion_promotes_crossed_beta_and_retains_literal_bits() -> crate::Result<()>
+    {
+        use crate::query::{EnableScoring, TermQuery};
+        use crate::schema::{IndexRecordOption, Schema, TEXT};
+        let mut schema = Schema::builder();
+        let field = schema.add_text_field("text", TEXT);
+        let index = crate::Index::create_in_ram(schema.build());
+        let mut writer = index.writer_for_tests()?;
+        for doc in 0..1536 {
+            let mut text = "alpha beta".to_string();
+            if doc == 138 {
+                for _ in 0..19 {
+                    text.push_str(" beta");
+                }
+            }
+            if doc % 3 != 2 {
+                let tf = match doc {
+                    127 => 2000,
+                    1024 => 1000,
+                    130 => 20,
+                    _ => 1,
+                };
+                for _ in 0..tf {
+                    text.push_str(" gamma");
+                }
+            }
+            writer.add_document(doc!(field => text))?;
+        }
+        writer.commit()?;
+        let searcher = index.reader()?.searcher();
+        let mut scorers = Vec::new();
+        for (term, boost) in [("alpha", 0.005), ("beta", 0.01), ("gamma", 1.0)] {
+            let query = TermQuery::new(
+                crate::Term::from_field_text(field, term),
+                IndexRecordOption::WithFreqs,
+            );
+            let weight =
+                query.specialized_weight(EnableScoring::enabled_from_searcher(&searcher))?;
+            let mut scorer = weight
+                .term_scorer_for_test(searcher.segment_reader(0), boost)?
+                .unwrap();
+            scorer.seek(17);
+            scorers.push(scorer);
+        }
+        assert_eq!(
+            scorers.iter().map(DocSet::size_hint).collect::<Vec<_>>(),
+            [1536, 1536, 1024]
+        );
+        let leaves = scalar_leaves(&scorers);
+        let later_beta =
+            Score::from_bits(leaves[1].iter().find(|&&(doc, _, _)| doc == 138).unwrap().2);
+        let selected_alpha = scorers[0].clone().block_max_score();
+        let selected_beta = scorers[1].clone().block_max_score();
+        let selected_sum = f64::from(selected_alpha) + f64::from(selected_beta);
+        let later_sum = f64::from(selected_alpha) + f64::from(later_beta);
+        assert!(selected_sum < later_sum);
+        let threshold = ((selected_sum + later_sum) * 0.5) as Score;
+        let (accepted, evidence) = check_widening(scorers.clone(), 1536, threshold, 0);
+        let first = &evidence.preparations[0];
+        assert_eq!((first.lo, first.tight_hi, first.hi), (17, 128, 145));
+        assert_eq!(first.ordinals, [0, 1, 2]);
+        assert_eq!(first.tight_first_essential, 2);
+        assert_eq!(first.selected_ends, [128, 128, 191]);
+        let region = evidence
+            .regions
+            .iter()
+            .find(|region| region.lo == 17)
+            .unwrap();
+        assert_eq!(
+            (region.tight_first_essential, region.first_essential),
+            (2, 1)
+        );
+        assert!(region.selected_bounds[1] < later_beta);
+        assert!(later_beta <= region.bounds[1] && region.bounds[1] < scorers[1].max_score());
+        assert!(
+            evidence.progress.iter().any(|event| matches!(
+                event,
+                CursorProgress::Advance {
+                    ordinal: 1,
+                    before: 127,
+                    doc: 128,
+                    ..
+                }
+            )),
+            "promoted beta crosses a real full-block boundary"
+        );
+        assert!(accepted.iter().any(|&(doc, _)| doc == 138));
+        Ok(())
+    }
