+    #[test]
+    fn capped_expansion_restores_virtual_zero_before_replay() {
+        let norms = vec![1; 1600];
+        let dense: Vec<_> = (0..800).map(|doc| (doc, 1)).collect();
+        let future: Vec<_> = (132..732).map(|doc| (doc, 1)).collect();
+        let driver: Vec<_> = (0..400).map(|i| (i * 3, 1)).collect();
+        let originals = vec![
+            fixture(&dense, &norms, 0.01),
+            fixture(&future, &norms, 0.02),
+            fixture(&driver, &norms, 0.1),
+        ];
+        for reverse in [false, true] {
+            let mut scorers = originals.clone();
+            for scorer in &mut scorers {
+                if scorer.doc() < 100 {
+                    scorer.seek(100);
+                }
+            }
+            if reverse {
+                scorers.reverse();
+            }
+            let future_ordinal = 1;
+            let leaves = scalar_leaves(&scorers);
+            let (accepted, evidence) = check_widening(scorers, 1600, 0.015, 0);
+            let first = &evidence.preparations[0];
+            assert_eq!((first.lo, first.tight_hi, first.hi), (100, 128, 228));
+            let rank = first
+                .ordinals
+                .iter()
+                .position(|&ordinal| ordinal == future_ordinal)
+                .unwrap();
+            assert_eq!(first.docs[rank], 132);
+            assert!(rank < first.tight_first_essential);
+            let region = evidence
+                .regions
+                .iter()
+                .find(|region| region.lo == 100)
+                .unwrap();
+            assert!(region.bounds[rank] > 0.0 && rank >= region.first_essential);
+            let literal = Score::from_bits(leaves[future_ordinal][0].2);
+            assert!(literal <= region.bounds[rank]);
+            assert!(accepted.iter().any(|&(doc, _)| doc == 132));
+        }
+    }
