+    type ScalarLeaf = (DocId, u32, u32);
+
+    struct WideningEvidence {
+        preparations: Vec<PreparedRegion>,
+        regions: Vec<WidenedRegion>,
+        progress: Vec<CursorProgress>,
+        skips: Vec<(DocId, DocId)>,
+    }
+
+    fn scalar_leaves(scorers: &[TermScorer]) -> Vec<Vec<ScalarLeaf>> {
+        scorers
+            .iter()
+            .cloned()
+            .map(|mut scorer| {
+                let mut leaves = Vec::new();
+                while scorer.doc() != TERMINATED {
+                    leaves.push((scorer.doc(), scorer.term_freq(), scorer.score().to_bits()));
+                    scorer.advance();
+                }
+                leaves
+            })
+            .collect()
+    }
+
+    fn begin_widening_evidence() {
+        PREPARED_REGIONS.with(|regions| *regions.borrow_mut() = Some(Vec::new()));
+        WIDENED_REGIONS.with(|regions| *regions.borrow_mut() = Some(Vec::new()));
+        CURSOR_PROGRESS.with(|progress| *progress.borrow_mut() = Some(Vec::new()));
+        TIGHT_SKIPS.with(|skips| *skips.borrow_mut() = Some(Vec::new()));
+    }
+
+    fn finish_widening_evidence(leaves: &[Vec<ScalarLeaf>]) -> WideningEvidence {
+        let evidence = WideningEvidence {
+            preparations: PREPARED_REGIONS.with(|regions| regions.borrow_mut().take().unwrap()),
+            regions: WIDENED_REGIONS.with(|regions| regions.borrow_mut().take().unwrap()),
+            progress: CURSOR_PROGRESS.with(|progress| progress.borrow_mut().take().unwrap()),
+            skips: TIGHT_SKIPS.with(|skips| skips.borrow_mut().take().unwrap()),
+        };
+        for prepared in &evidence.preparations {
+            let essential_end = *prepared.selected_ends[prepared.tight_first_essential..]
+                .iter()
+                .min()
+                .unwrap();
+            // Widened u64 arithmetic independently checks the chosen endpoint,
+            // including rejected proposals and already-wide sparse regions.
+            let cap = (u64::from(prepared.lo) + COMPRESSION_BLOCK_SIZE as u64)
+                .min(u64::from(prepared.max_doc)) as DocId;
+            let expected = prepared.tight_hi.max(essential_end.min(cap));
+            assert_eq!(prepared.hi, expected, "{prepared:?}");
+            assert_eq!(
+                prepared.tight_hi,
+                *prepared.selected_ends.iter().min().unwrap()
+            );
+            let independent_bound =
+                crate::query::score_combiner::ScoreSumUpperBound::new(leaves.len());
+            let mut sum = 0.0f64;
+            let mut first = 0;
+            for (&doc, &bound) in prepared.docs.iter().zip(&prepared.selected_bounds) {
+                sum += if doc >= prepared.tight_hi {
+                    0.0
+                } else {
+                    f64::from(bound)
+                };
+                if independent_bound.score(sum) <= prepared.threshold {
+                    first += 1;
+                } else {
+                    break;
+                }
+            }
+            assert_eq!(prepared.tight_first_essential, first, "{prepared:?}");
+            assert_eq!(prepared.final_bounds.len(), leaves.len());
+            let mut final_sum = 0.0f64;
+            let mut final_first = 0;
+            for &bound in &prepared.final_bounds {
+                final_sum += f64::from(bound);
+                if independent_bound.score(final_sum) <= prepared.threshold {
+                    final_first += 1;
+                } else {
+                    break;
+                }
+            }
+            assert_eq!(
+                prepared.final_first_essential,
+                Some(final_first),
+                "{prepared:?}"
+            );
+            for (rank, &ordinal) in prepared.ordinals.iter().enumerate() {
+                let floor = prepared.lo.max(prepared.docs[rank]);
+                for &(doc, _, bits) in &leaves[ordinal] {
+                    if floor <= doc && doc < prepared.hi {
