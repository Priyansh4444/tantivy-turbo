+    #[test]
+    fn capped_partition_stops_before_the_later_optional_after_overflow() {
+        let norms = vec![1; 1200];
+        let dense: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let future: Vec<_> = (132..732)
+            .map(|doc| (doc, if doc == 200 { 1000 } else { 1 }))
+            .collect();
+        let later_optional: Vec<_> = (133..733).map(|doc| (doc, 1)).collect();
+        let driver: Vec<_> = (0..130).map(|i| (4 * i, 1)).collect();
+        let mut originals = vec![
+            fixture(&dense, &norms, 0.001),
+            fixture(&future, &norms, 0.02),
+            fixture(&later_optional, &norms, 0.03),
+            fixture(&driver, &norms, 0.1),
+        ];
+        for scorer in &mut originals {
+            scorer.seek(100);
+        }
+        for reverse in [false, true] {
+            let mut ordered = originals.clone();
+            if reverse {
+                ordered.reverse();
+            }
+            for limit in [0, 1, 10] {
+                let (accepted, evidence) = check_widening(ordered.clone(), 1200, 0.015, limit);
+                let first = &evidence.proposals[0];
+                assert_eq!(
+                    (first.lo, first.tight_hi, first.proposed_hi, first.hi),
+                    (100, 128, 228, 128)
+                );
+                assert_eq!(
+                    first.ordinals,
+                    if reverse {
+                        vec![3, 2, 1, 0]
+                    } else {
+                        vec![0, 1, 2, 3]
+                    }
+                );
+                assert_eq!(first.first_essential, 3);
+                assert!(!first.admitted);
+                assert_eq!(first.proposed_bounds.len(), 2);
+                assert_eq!(first.docs[1..3], [132, 133]);
+                assert!(first.bounds[1] == 0.0 && first.bounds[2] == 0.0);
+                assert_eq!(first.tight_prefix, first.chosen_prefix);
+                assert!(accepted.iter().any(|&(doc, _)| doc == 200));
+            }
+        }
+    }
