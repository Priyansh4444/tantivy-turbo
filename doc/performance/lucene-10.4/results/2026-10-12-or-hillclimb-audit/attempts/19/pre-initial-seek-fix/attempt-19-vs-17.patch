+    #[test]
+    fn capped_partition_admits_and_rejects_zero_restoration_n3_n32() {
+        let norms = vec![1; 3000];
+        let dense: Vec<_> = (0..1024).map(|doc| (doc, 1)).collect();
+        let future: Vec<_> = (132..732)
+            .map(|doc| (doc, if doc == 200 { 1000 } else { 1 }))
+            .collect();
+        let driver: Vec<_> = (0..600).map(|i| (4 * i, 1)).collect();
+        for count in [3, 32] {
+            for reject in [false, true] {
+                let mut originals: Vec<_> = (0..count - 2)
+                    .map(|i| fixture(&dense, &norms, 0.00001 * (i + 1) as Score))
+                    .collect();
+                originals.push(fixture(&future, &norms, if reject { 0.02 } else { 0.001 }));
+                originals.push(fixture(&driver, &norms, 0.1));
+                for scorer in &mut originals {
+                    scorer.seek(100);
+                }
+                for reverse in [false, true] {
+                    let mut ordered = originals.clone();
+                    if reverse {
+                        ordered.reverse();
+                    }
+                    let future_ordinal = if reverse { 1 } else { count - 2 };
+                    for limit in [0, 1, 10] {
+                        let (accepted, evidence) =
+                            check_widening(ordered.clone(), 3000, 0.025, limit);
+                        let first = &evidence.proposals[0];
+                        assert_eq!(
+                            (first.lo, first.tight_hi, first.proposed_hi),
+                            (100, 128, 228)
+                        );
+                        assert_eq!(first.first_essential, count - 1);
+                        assert_eq!(first.admitted, !reject);
+                        assert_eq!(first.hi, if reject { 128 } else { 228 });
+                        let rank = first
+                            .ordinals
+                            .iter()
+                            .position(|&ordinal| ordinal == future_ordinal)
+                            .unwrap();
+                        assert_eq!(rank, count - 2);
+                        assert_eq!(first.docs[rank], 132);
+                        assert!(first.proposed_bounds[rank] > 0.0);
+                        if reject {
+                            assert_eq!(first.bounds[rank].to_bits(), 0.0f32.to_bits());
+                            assert_eq!(first.tight_prefix, first.chosen_prefix);
+                        } else {
+                            assert!(first.bounds[rank] > 0.0);
+                            assert!(evidence
+                                .regions
+                                .iter()
+                                .any(|region| region.lo == 100 && region.hi == 228));
+                            assert!(evidence.progress.iter().any(|event| matches!(event,
+                                CursorProgress::Batch {floor:100,up_to:228,docs,doc:228,..}
+                                if docs.len()==32 && docs.first()==Some(&100) && docs.last()==Some(&224)
+                            )));
+                        }
+                        assert!(accepted.iter().any(|&(doc, _)| doc == 200));
+                    }
+                }
+            }
+        }
+    }
