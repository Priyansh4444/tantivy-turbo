+            Score::from_bits(leaves[1].iter().find(|&&(doc, _, _)| doc == 138).unwrap().2);
+        let selected_alpha = scorers[0].clone().block_max_score();
+        let selected_beta = scorers[1].clone().block_max_score();
+        let selected_sum = f64::from(selected_alpha) + f64::from(selected_beta);
+        let later_sum = f64::from(selected_alpha) + f64::from(later_beta);
+        assert!(selected_sum < later_sum);
+        let threshold = ((selected_sum + later_sum) * 0.5) as Score;
+        let (accepted, evidence) = check_widening(scorers.clone(), 1536, threshold, 0);
+        let first = &evidence.proposals[0];
+        assert_eq!(
+            (first.lo, first.tight_hi, first.proposed_hi, first.hi),
